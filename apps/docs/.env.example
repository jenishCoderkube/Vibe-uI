# ==========================================
# Vibe UI Documentation - Environment Variables
# ==========================================

# 1. Receiver Email Address
# Destination inbox where contact form submissions will be delivered
CONTACT_RECEIVER_EMAIL="admin@vibeui.com"

# 2. Resend API Key (Optional for production email delivery)
# Create a free account & get your key at https://resend.com
RESEND_API_KEY="re_123456789_dummy_key_for_production"

# 3. Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Google Analytics Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-7D6P1RZKG1"

