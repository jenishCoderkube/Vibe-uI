{
  "name": "vibe-ui-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "preinstall": "node -e \"require('fs').existsSync('.git/hooks/code-guardian/git-hooks/checkInstall.cjs') && require('child_process').execFileSync('node', ['.git/hooks/code-guardian/git-hooks/checkInstall.cjs'], {stdio:'inherit'})\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "20.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.2.5",
    "turbo": "^2.10.8",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.0.0"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.5"
}
